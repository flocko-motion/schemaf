#!/bin/bash
# Code generated by schemaf codegen. DO NOT EDIT.
# Regenerate with: ./schemaf.sh codegen
#
# schemaf.sh — the project entrypoint, in two modes:
#
#   checkout  next to schemaf.toml: codegen, test, dev, build, run, upgrade and
#             the app's own subcommands (via `go run`).
#   run side  installed as ~/.{{.Name}}/bin/schemaf.sh by a deployment artifact's
#             `load`, with no checkout: run --image, stop, status, logs, image,
#             and app subcommands exec'd in the running backend container.
#
# ARCHITECTURE: everything that can run in Go does (cli/cmd/*/). The shell holds
# only what must work without Go: finding the project root, loading env vars,
# and build / run / load / the run side, because build and run hosts have no
# Go (see INSTALL.md › Deployment). Do not add application logic here.
#
# Bash 3.2 compatible (macOS /bin/bash): no mapfile, no associative arrays,
# no empty-array expansion under `set -u`.
set -euo pipefail

# Fail loudly. Under `set -e`, an unexpected error (e.g. a pipeline member killed
# by SIGPIPE → exit 141) otherwise aborts the script silently with only a numeric
# exit code. This trap reports the failing command, line, and exit code instead.
trap 'rc=$?; echo "ERROR: schemaf.sh failed at line ${LINENO}: \"${BASH_COMMAND}\" (exit ${rc})" >&2; exit ${rc}' ERR

PROJECT_NAME="{{.Name}}"
SCHEMAF_VER="{{.SchemafVersion}}"
ORIG_PWD="$PWD"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
USER_DIR="$HOME/.${PROJECT_NAME}"
DEPLOY_DIR="$USER_DIR/deploy"
NO_CHECKOUT="this host has no checkout; that command runs on a dev or build host"

# Go template delimiters for --format arguments of the container CLI.
_O='{{"{{"}}' _C='{{"}}"}}'

# Temporary directories, removed on exit.
_SCHEMAF_TMP=""
_schemaf_cleanup() {
  local d
  for d in $_SCHEMAF_TMP; do rm -rf "$d"; done
  _SCHEMAF_TMP=""
}
trap _schemaf_cleanup EXIT
_schemaf_mktemp() {
  local d
  d=$(mktemp -d "${TMPDIR:-/tmp}/schemaf.XXXXXX")
  _SCHEMAF_TMP="$_SCHEMAF_TMP $d"
  echo "$d"
}

_die() {
  echo "ERROR: $*" >&2
  exit 1
}

# Load env vars from a file. Only sets variables not already in the environment.
_schemaf_load_env() {
  local envfile="$1" key val
  [ -f "$envfile" ] || return 0
  while IFS='=' read -r key val; do
    key=$(echo "$key" | xargs)
    [ -z "$key" ] || [[ "$key" == \#* ]] && continue
    val=$(echo "$val" | xargs)
    if [ -z "${!key:-}" ]; then
      export "$key=$val"
    fi
  done < "$envfile"
}

# Read only SCHEMAF_RUNTIME from an env file, if the environment doesn't set it.
# build uses this instead of _schemaf_load_env: it runs third-party code
# (npm install) and must never see the other variables (INSTALL.md › Secrets).
_schemaf_env_runtime() {
  local envfile="$1" key val
  [ -z "${SCHEMAF_RUNTIME:-}" ] || return 0
  [ -f "$envfile" ] || return 0
  while IFS='=' read -r key val; do
    key=$(echo "$key" | xargs)
    if [ "$key" = SCHEMAF_RUNTIME ]; then
      export SCHEMAF_RUNTIME="$(echo "$val" | xargs)"
      return 0
    fi
  done < "$envfile"
}

# Every container call goes through _schemaf_container — never call podman or
# docker directly. The runtime is SCHEMAF_RUNTIME: podman (the default) or docker.
# See INSTALL.md › Container runtime.
#   --exec   the runtime replaces this shell
#   --other  run the runtime that is NOT selected (for the data volume check)
_schemaf_container() {
  local rt="${SCHEMAF_RUNTIME:-podman}" use_exec=0 other=0
  while :; do
    case "${1:-}" in
      --exec) use_exec=1; shift ;;
      --other) other=1; shift ;;
      *) break ;;
    esac
  done
  case "$rt" in
    podman|docker) ;;
    *)
      echo "ERROR: SCHEMAF_RUNTIME=\"$rt\" is not a valid container runtime — valid values: podman (the default), docker" >&2
      return 1
      ;;
  esac
  if [ "$other" = 1 ]; then
    if [ "$rt" = podman ]; then rt=docker; else rt=podman; fi
    command -v "$rt" >/dev/null 2>&1 || { echo "ERROR: $rt is not installed" >&2; return 1; }
  elif ! command -v "$rt" >/dev/null 2>&1; then
    if [ "$rt" = podman ]; then
      echo "ERROR: podman is not installed — install podman and docker-compose, or set SCHEMAF_RUNTIME=docker" >&2
    else
      echo "ERROR: SCHEMAF_RUNTIME=docker, but docker is not installed — install Docker, or unset SCHEMAF_RUNTIME to use podman" >&2
    fi
    return 1
  fi
  # podman compose announces its external provider on every call; silence it.
  export PODMAN_COMPOSE_WARNING_LOGS="${PODMAN_COMPOSE_WARNING_LOGS:-false}"
  if [ "$use_exec" = 1 ]; then
    _schemaf_cleanup   # exec skips the EXIT trap
    exec "$rt" "$@"
  fi
  "$rt" "$@"
}

# _schemaf_check_runtime [compose] — the selected runtime is installed and its
# engine answers; with "compose", its compose is docker-compose (Compose v2).
# Mirrors the Go checks (cli.CheckRuntime) for the commands that run without Go.
_schemaf_check_runtime() {
  local rt="${SCHEMAF_RUNTIME:-podman}" out
  _schemaf_container --help >/dev/null || exit 1
  if ! out=$(_schemaf_container info 2>&1); then
    echo "ERROR: $rt is installed, but not usable. $rt info said:" >&2
    echo "$out" | sed 's/^/  /' >&2
    if [ "$rt" = podman ] && [ "$(uname)" = Darwin ]; then
      echo "Start the podman machine: podman machine start (create it once first: podman machine init)" >&2
    elif [ "$rt" = docker ]; then
      echo "Start Docker (Docker Desktop, or: sudo systemctl start docker), or unset SCHEMAF_RUNTIME to use podman" >&2
    fi
    echo "See INSTALL.md › Container runtime (docs/schemaf/INSTALL.md)" >&2
    exit 1
  fi
  [ "${1:-}" = compose ] || return 0
  out=$(_schemaf_container compose version 2>&1) || true
  case "$out" in
    *"Docker Compose version"*) ;;
    *)
      echo "ERROR: $rt compose must be docker-compose (Compose v2). $rt compose version said:" >&2
      echo "$out" | sed 's/^/  /' >&2
      echo "Install docker-compose (macOS: brew install docker-compose; other systems: https://github.com/docker/compose/releases)" >&2
      echo "See INSTALL.md › Container runtime (docs/schemaf/INSTALL.md)" >&2
      exit 1
      ;;
  esac
}

# Refuse to start when the other runtime holds the project's Postgres volume
# (INSTALL.md › Container runtime). Skipped when the other runtime isn't
# installed or usable. Never migrates or deletes anything.
_schemaf_check_volume() {
  local vol="${PROJECT_NAME}-postgres-data" rt="${SCHEMAF_RUNTIME:-podman}" other hint
  _schemaf_container --other info >/dev/null 2>&1 || return 0
  _schemaf_container --other volume inspect "$vol" >/dev/null 2>&1 || return 0
  if [ "$rt" = podman ]; then other=docker; hint="set SCHEMAF_RUNTIME=docker"; else other=podman; hint="unset SCHEMAF_RUNTIME to use podman, the default"; fi
  cat >&2 <<EOF
ERROR: refusing to start: the Postgres volume $vol exists in $other, but the selected container runtime is $rt.
The project's data volume may exist only in the selected runtime. Choose one:
  1. Migrate the data to $rt: INSTALL.md › Migrating from Docker to podman (docs/schemaf/INSTALL.md)
  2. Or keep the data where it is and use $other: $hint
     (in your shell profile, or in ~/.${PROJECT_NAME}/etc/env)
  3. Or, if the data is throwaway, delete it: $other volume rm $vol
EOF
  exit 1
}

# >>> inputs-hash — the shell side of gen/inputs.sha256 (cli/cmd/codegen/inputs.go).
# The input list is rendered from Go's inputGlobs; a test checks both agree.

# stdin → hex SHA-256.
_schemaf_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | cut -d' ' -f1
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | cut -d' ' -f1
  else
    echo "ERROR: neither sha256sum nor shasum is installed — install coreutils (sha256sum) or perl (shasum)" >&2
    return 1
  fi
}

# The schemaf version required in go/go.mod: the first non-comment line holding
# the module path directly followed by a field starting with "v".
_schemaf_gomod_version() {
  local v
  v=$(awk '$1 !~ /^\/\// { for (i = 1; i < NF; i++) if ($i == "github.com/flocko-motion/schemaf" && $(i+1) ~ /^v/) { print $(i+1); exit } }' go/go.mod)
  [ -n "$v" ] || { echo "ERROR: go/go.mod requires no version of github.com/flocko-motion/schemaf" >&2; return 1; }
  echo "$v"
}

_schemaf_inputs_hash() (
  shopt -s nullglob
  list=""
  for f in {{.InputGlobs}}; do
    [ -f "$f" ] || continue
    case "$f" in {{.InputExcludes}}) continue ;; esac
    list="${list}${f}"$'\n'
  done
  ver=$(_schemaf_gomod_version) || exit 1
  {
    printf '%s' "$list" | LC_ALL=C sort | while IFS= read -r f; do
      [ -n "$f" ] || continue
      sum=$(_schemaf_sha256 < "$f") || exit 1
      printf '%s  %s\n' "$sum" "$f"
    done
    printf 'schemaf %s\n' "$ver"
  } | _schemaf_sha256
)
# <<< inputs-hash

# Refuse when generated files don't match their inputs (EXTEND.md › Code Generation).
_schemaf_check_fresh() {
  local want got
  [ -f gen/inputs.sha256 ] || _die "gen/inputs.sha256 not found — run ./schemaf.sh codegen and commit"
  want=$(tr -d '[:space:]' < gen/inputs.sha256)
  got=$(_schemaf_inputs_hash) || exit 1
  [ "$want" = "$got" ] || _die "generated files are stale — run ./schemaf.sh codegen and commit"
}

# --- images -------------------------------------------------------------------

_schemaf_image_exists() {
  _schemaf_container image inspect "$1" >/dev/null 2>&1
}

# _schemaf_image_label <image> <label> — the label's value, empty if unset.
_schemaf_image_label() {
  _schemaf_container image inspect --format "${_O}index .Config.Labels \"$2\"${_C}" "$1"
}

_schemaf_check_tag() {
  local re='^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$'
  [[ "$1" =~ $re ]] || _die "invalid tag \"$1\" — use letters, digits, _ . - (at most 128, not starting with . or -)"
}

# The platform this host runs images for, as the image's Os/Architecture.
_schemaf_host_platform() {
  case "$(uname -m)" in
    x86_64|amd64) echo linux/amd64 ;;
    aarch64|arm64) echo linux/arm64 ;;
    *) echo "linux/$(uname -m)" ;;
  esac
}

# The backend container's state and image tag: "<running> <tag>", e.g.
# "true 3f9a2c1"; empty when there is no backend container.
_schemaf_backend() {
  local out
  out=$(_schemaf_container container inspect --format "${_O}.State.Running${_C} ${_O}.Config.Image${_C}" "${PROJECT_NAME}-backend" 2>/dev/null) || return 0
  echo "${out%% *} ${out##*:}"
}

# The tag of the running backend, empty if none is running.
_schemaf_running_tag() {
  local b
  b=$(_schemaf_backend)
  [ "${b%% *}" = true ] && echo "${b#* }" || true
}

_schemaf_manifest_get() {
  local v
  v=$(grep "^$2=" "$1" | head -n 1) || true
  echo "${v#*=}"
}

# --- build (checkout) ---------------------------------------------------------

# _schemaf_build [--tag <tag>] [--output <file>] [--force]
# Sets BUILT_IMAGE. See INSTALL.md › Deployment › build.
_schemaf_build() {
  local tag="" output="" force=0 commit short describe dirty=false ctx have
  while [ $# -gt 0 ]; do
    case "$1" in
      --tag) [ $# -ge 2 ] || _die "--tag needs a value"; tag="$2"; shift 2 ;;
      --tag=*) tag="${1#--tag=}"; shift ;;
      --output) [ $# -ge 2 ] || _die "--output needs a file"; output="$2"; shift 2 ;;
      --output=*) output="${1#--output=}"; shift ;;
      --force) force=1; shift ;;
      *) _die "build: unknown argument \"$1\" — usage: ./schemaf.sh build [--tag <tag>] [--output <file>] [--force]" ;;
    esac
  done

  command -v git >/dev/null 2>&1 || _die "build needs git — the image is named after its commit"
  git rev-parse --git-dir >/dev/null 2>&1 || _die "build needs a git repository — the image is named after its commit"
  commit=$(git rev-parse --verify -q HEAD) || _die "build needs a commit — this repository has none yet"
  short=$(git rev-parse --short HEAD)
  [ -z "$(git status --porcelain)" ] || dirty=true
  describe=$(git describe --tags --always --dirty)

  if [ -n "$output" ]; then
    [ "$dirty" = false ] || _die "commit first — a deployment artifact must name exactly one commit"
    case "$output" in /*) ;; *) output="$ORIG_PWD/$output" ;; esac
    [ ! -e "$output" ] && [ ! -L "$output" ] || _die "$output already exists — remove it or choose another --output"
    [ -d "$(dirname "$output")" ] || _die "$(dirname "$output") does not exist"
  fi
  if [ -z "$tag" ]; then
    tag="$short"
    [ "$dirty" = false ] || tag="${short}-dirty"
  fi
  _schemaf_check_tag "$tag"
  _schemaf_check_fresh
  _schemaf_check_runtime

  BUILT_IMAGE="${PROJECT_NAME}:${tag}"
  if _schemaf_image_exists "$BUILT_IMAGE"; then
    have=$(_schemaf_image_label "$BUILT_IMAGE" schemaf.commit)
    if [ "$dirty" = false ] && [ "$force" = 0 ] && [ "$have" = "$commit" ] \
      && [ "$(_schemaf_image_label "$BUILT_IMAGE" schemaf.dirty)" = false ]; then
      echo "Already built: $BUILT_IMAGE (commit $short) — --force rebuilds it" >&2
      [ -z "$output" ] || _schemaf_write_artifact "$output" "$tag" "$commit" "$describe"
      return 0
    fi
    if [ -n "$have" ] && [ "$have" != "$commit" ]; then
      echo "Replacing $BUILT_IMAGE (was commit ${have:0:7}) with commit $short" >&2
    fi
  fi

  if [ "$dirty" = true ]; then
    echo "Building $BUILT_IMAGE from the working tree (uncommitted changes)..." >&2
    ctx="$PROJECT_ROOT"
  else
    # Exactly the commit: untracked and ignored files never reach the image.
    echo "Building $BUILT_IMAGE from commit $short..." >&2
    ctx=$(_schemaf_mktemp)
    git archive HEAD | tar -x -C "$ctx"
  fi
  _schemaf_container build -f "$ctx/Dockerfile.gen" -t "$BUILT_IMAGE" \
    --label "schemaf.project=$PROJECT_NAME" \
    --label "schemaf.commit=$commit" \
    --label "schemaf.describe=$describe" \
    --label "schemaf.version=$SCHEMAF_VER" \
    --label "schemaf.dirty=$dirty" \
    "$ctx"
  echo "Built $BUILT_IMAGE" >&2
  [ -z "$output" ] || _schemaf_write_artifact "$output" "$tag" "$commit" "$describe"
}

# The self-extracting header of a deployment artifact. Everything after the
# marker line is a gzipped tar; `load` hands it to the archive's own schemaf.sh.
_schemaf_artifact_header() {
  echo '#!/bin/bash'
  echo "# ${PROJECT_NAME} deployment artifact, built by schemaf. Run: ./$(basename "$1") load"
  echo "# See INSTALL.md › Deployment. Everything below the marker line is a gzipped tar."
  cat <<'HEADER'
set -euo pipefail
if [ $# -ne 1 ] || [ "$1" != load ]; then
  echo "usage: $0 load" >&2
  echo "  loads this build into the current user's container store and installs ~/.<name>/bin/schemaf.sh" >&2
  exit 2
fi
tmp=$(mktemp -d "${TMPDIR:-/tmp}/schemaf-load.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
line=$(awk '/^__SCHEMAF_ARCHIVE__$/ { print NR + 1; exit }' "$0")
tail -n +"$line" "$0" | tar -xz -C "$tmp"
bash "$tmp/schemaf.sh" __load "$tmp"
exit 0
__SCHEMAF_ARCHIVE__
HEADER
}

# _schemaf_write_artifact <output> <tag> <commit> <describe>
_schemaf_write_artifact() {
  local output="$1" tag="$2" commit="$3" describe="$4" stage partial f platform
  echo "Writing $output..." >&2
  stage=$(_schemaf_mktemp)
  _schemaf_container save -o "$stage/image.tar" "$BUILT_IMAGE"
  platform=$(_schemaf_container image inspect --format "${_O}.Os${_C}/${_O}.Architecture${_C}" "$BUILT_IMAGE")
  mkdir "$stage/compose"
  cp compose.gen.yml "$stage/compose.gen.yml"
  for f in compose/*.yml; do
    [ -f "$f" ] || continue
    case "$f" in *.dev.yml) continue ;; esac
    cp "$f" "$stage/compose/"
  done
  cp schemaf.sh "$stage/schemaf.sh"
  {
    echo "name=$PROJECT_NAME"
    echo "tag=$tag"
    echo "commit=$commit"
    echo "describe=$describe"
    echo "schemaf_version=$SCHEMAF_VER"
    echo "platform=$platform"
  } > "$stage/manifest"
  partial=$(mktemp "${output}.XXXXXX")
  { _schemaf_artifact_header "$output"; tar -cz -C "$stage" .; } > "$partial"
  chmod 755 "$partial"
  mv "$partial" "$output"
  echo "Wrote $output — on the run host: $(basename "$output") load" >&2
}

# --- load (run side, called by an artifact's header) --------------------------

# _schemaf_load <extracted archive dir>
_schemaf_load() {
  local dir="$1" m name tag commit platform host img have dest old
  m="$dir/manifest"
  for f in manifest image.tar schemaf.sh compose.gen.yml; do
    [ -f "$dir/$f" ] || _die "the archive has no $f — it is not a schemaf deployment artifact, or it is damaged"
  done
  name=$(_schemaf_manifest_get "$m" name)
  tag=$(_schemaf_manifest_get "$m" tag)
  commit=$(_schemaf_manifest_get "$m" commit)
  platform=$(_schemaf_manifest_get "$m" platform)
  [ "$name" = "$PROJECT_NAME" ] || _die "the manifest names project \"$name\", its schemaf.sh \"$PROJECT_NAME\" — the archive is damaged"
  _schemaf_check_tag "$tag"
  [ -n "$commit" ] || _die "the manifest names no commit — the archive is damaged"

  _schemaf_load_env "$USER_DIR/etc/env"
  _schemaf_check_runtime
  host=$(_schemaf_host_platform)
  [ "$platform" = "$host" ] || _die "this archive's image is for $platform, this host runs $host — build it on a $host machine"

  img="${PROJECT_NAME}:${tag}"
  dest="$DEPLOY_DIR/$tag"
  if _schemaf_image_exists "$img"; then
    have=$(_schemaf_image_label "$img" schemaf.commit)
    [ -n "$have" ] || _die "$img exists but wasn't built by schemaf (it has no schemaf.commit label) — remove that image first"
  elif [ -f "$dest/manifest" ]; then
    have=$(_schemaf_manifest_get "$dest/manifest" commit)
  else
    have=""
  fi
  if [ -n "$have" ] && [ "$have" != "$commit" ]; then
    _die "$tag is already loaded from commit ${have:0:7}, this archive is commit ${commit:0:7} — remove it first (schemaf.sh image rm $tag) or build with a different tag"
  fi
  if [ -n "$have" ] && _schemaf_image_exists "$img" && [ -f "$dest/manifest" ]; then
    echo "$tag is already loaded (commit ${commit:0:7}) — nothing to do" >&2
    echo "$tag"
    return 0
  fi

  if ! _schemaf_image_exists "$img"; then
    echo "Loading $img..." >&2
    _schemaf_container load -i "$dir/image.tar" >&2
    have=$(_schemaf_image_label "$img" schemaf.commit 2>/dev/null) || have=""
    [ "$have" = "$commit" ] || _die "loading the archive did not produce $img from commit ${commit:0:7}"
  fi

  mkdir -p "$DEPLOY_DIR"
  old=$(_schemaf_mktemp)
  mkdir "$old/new"
  cp "$dir/compose.gen.yml" "$dir/manifest" "$old/new/"
  cp -R "$dir/compose" "$old/new/compose"
  rm -rf "$dest"
  mv "$old/new" "$dest"

  mkdir -p "$USER_DIR/bin"
  cp "$dir/schemaf.sh" "$old/schemaf.sh"
  chmod 755 "$old/schemaf.sh"
  mv "$old/schemaf.sh" "$USER_DIR/bin/schemaf.sh"
  echo "Loaded $img; start it with: ~/.${PROJECT_NAME}/bin/schemaf.sh run --image $tag" >&2
  echo "$tag"
}

# --- run side -----------------------------------------------------------------

_schemaf_runside_usage() {
  cat >&2 <<EOF
usage: ~/.${PROJECT_NAME}/bin/schemaf.sh <command>   (run side: no checkout on this host)
  run --image <tag> [flags]   start a loaded image (flags go to compose up, e.g. -d)
  stop                        stop the stack
  status                      list the stack's containers
  logs [flags]                show the stack's logs (flags go to compose logs, e.g. -f backend)
  image ls                    loaded tags
  image rm <tag>              remove a loaded tag (not the running one)
  <app subcommand> ...        run in the backend container, e.g. db backup
See INSTALL.md › Deployment.
EOF
}

# _schemaf_compose_current <compose args...> — compose on the stack's current
# deployment (the tag of the existing backend container).
_schemaf_compose_current() {
  local b tag
  b=$(_schemaf_backend)
  [ -n "$b" ] || return 3
  tag="${b#* }"
  [ -f "$DEPLOY_DIR/$tag/compose.gen.yml" ] || _die "the backend runs $tag, but $DEPLOY_DIR/$tag/ is missing"
  export SCHEMAF_IMAGE="${PROJECT_NAME}:${tag}"
  _schemaf_container --exec compose -f "$DEPLOY_DIR/$tag/compose.gen.yml" "$@"
}

_schemaf_run_image() {
  local tag="$1" img dest labelled deployed
  shift
  _schemaf_check_tag "$tag"
  _schemaf_check_runtime compose
  _schemaf_check_volume
  img="${PROJECT_NAME}:${tag}"
  dest="$DEPLOY_DIR/$tag"
  _schemaf_image_exists "$img" || _die "$img is not loaded — load its artifact first (./${PROJECT_NAME}-${tag}.run load); loaded tags: schemaf.sh image ls"
  [ -f "$dest/compose.gen.yml" ] && [ -f "$dest/manifest" ] || _die "$dest/ is missing — load the artifact again (./${PROJECT_NAME}-${tag}.run load)"
  labelled=$(_schemaf_image_label "$img" schemaf.commit)
  deployed=$(_schemaf_manifest_get "$dest/manifest" commit)
  [ "$labelled" = "$deployed" ] || _die "$img is commit ${labelled:0:7}, but $dest/ is commit ${deployed:0:7} — remove the tag (schemaf.sh image rm $tag) and load it again"
  export SCHEMAF_IMAGE="$img"
  _schemaf_container --exec compose -f "$dest/compose.gen.yml" up "$@"
}

_schemaf_image_ls() {
  local d tag img commit describe size running mark any=0
  running=$(_schemaf_running_tag)
  printf '%-24s %-9s %-28s %-8s %s\n' TAG COMMIT DESCRIBE SIZE RUNNING
  for d in "$DEPLOY_DIR"/*/; do
    [ -f "$d/manifest" ] || continue
    any=1
    tag=$(basename "$d")
    img="${PROJECT_NAME}:${tag}"
    commit=$(_schemaf_manifest_get "$d/manifest" commit)
    describe=$(_schemaf_manifest_get "$d/manifest" describe)
    if _schemaf_image_exists "$img"; then
      size=$(_schemaf_container image inspect --format "${_O}.Size${_C}" "$img" \
        | awk '{ s = $1; split("B KB MB GB TB", u, " "); i = 1; while (s >= 1024 && i < 5) { s /= 1024; i++ } printf "%.0f%s", s, u[i] }')
    else
      size="missing"
    fi
    mark=""
    [ "$tag" != "$running" ] || mark="*"
    printf '%-24s %-9s %-28s %-8s %s\n' "$tag" "${commit:0:7}" "$describe" "$size" "$mark"
  done
  [ "$any" = 1 ] || echo "No tags loaded — load an artifact: ./${PROJECT_NAME}-<tag>.run load" >&2
}

_schemaf_image_rm() {
  local tag="$1" img b
  _schemaf_check_tag "$tag"
  img="${PROJECT_NAME}:${tag}"
  b=$(_schemaf_backend)
  if [ -n "$b" ] && [ "${b#* }" = "$tag" ]; then
    if [ "${b%% *}" = true ]; then
      _die "$tag is running — start another tag first (schemaf.sh run --image <tag>), or stop it (schemaf.sh stop)"
    fi
    _die "$tag is used by the stopped ${PROJECT_NAME}-backend container — remove it first: schemaf.sh stop"
  fi
  if ! _schemaf_image_exists "$img" && [ ! -d "$DEPLOY_DIR/$tag" ]; then
    _die "$tag is not loaded (loaded tags: schemaf.sh image ls)"
  fi
  if _schemaf_image_exists "$img"; then
    _schemaf_container image rm "$img" >/dev/null
  fi
  rm -rf "$DEPLOY_DIR/$tag"
  echo "Removed $tag" >&2
}

_schemaf_runside() {
  local cmd="$1" b tty
  shift
  _schemaf_load_env "$USER_DIR/etc/env"
  case "$cmd" in
    run)
      [ "${1:-}" = --image ] && [ $# -ge 2 ] || _die "on the run side, run needs a tag: schemaf.sh run --image <tag> (loaded tags: schemaf.sh image ls)"
      local tag="$2"
      shift 2
      _schemaf_run_image "$tag" "$@"
      ;;
    stop)
      _schemaf_check_runtime compose
      _schemaf_compose_current down "$@" || { [ $? = 3 ] && echo "Nothing to stop: there is no ${PROJECT_NAME}-backend container" >&2; }
      ;;
    status)
      _schemaf_check_runtime compose
      _schemaf_compose_current ps "$@" || { [ $? = 3 ] && echo "Not running: there is no ${PROJECT_NAME}-backend container" >&2; }
      ;;
    logs)
      _schemaf_check_runtime compose
      _schemaf_compose_current logs "$@" || { [ $? = 3 ] && _die "no logs: there is no ${PROJECT_NAME}-backend container (start it: schemaf.sh run --image <tag>)"; }
      ;;
    image)
      _schemaf_check_runtime
      case "${1:-}" in
        ls) _schemaf_image_ls ;;
        rm) [ $# -eq 2 ] || _die "usage: schemaf.sh image rm <tag>"; _schemaf_image_rm "$2" ;;
        *) _die "usage: schemaf.sh image ls | image rm <tag>" ;;
      esac
      ;;
    codegen|test|dev|build|upgrade)
      _die "$NO_CHECKOUT"
      ;;
    server)
      _die "the server runs in the backend container — start it with: schemaf.sh run --image <tag>"
      ;;
    ""|-h|--help|help)
      _schemaf_runside_usage
      ;;
    *)
      # An app subcommand: run it in exactly the deployed version.
      _schemaf_check_runtime
      [ -n "$(_schemaf_running_tag)" ] || _die "start it first: schemaf.sh run --image <tag> (loaded tags: schemaf.sh image ls)"
      tty="-i"
      if [ -t 0 ] && [ -t 1 ]; then tty="-it"; fi
      _schemaf_container --exec exec "$tty" "${PROJECT_NAME}-backend" /app "$cmd" "$@"
      ;;
  esac
}

# --- dispatch -----------------------------------------------------------------

CMD="${1:-}"
shift 2>/dev/null || true

# An artifact's header runs the archive's own schemaf.sh: __load <extracted dir>.
if [ "$CMD" = __load ]; then
  echo "schemaf ${SCHEMAF_VER} — ${PROJECT_NAME}" >&2
  [ $# -eq 1 ] && [ -d "$1" ] || _die "__load is called by a deployment artifact: ./${PROJECT_NAME}-<tag>.run load"
  _schemaf_load "$1"
  exit 0
fi

if [ ! -f "$SCRIPT_DIR/schemaf.toml" ]; then
  if [ -d "$USER_DIR/bin" ] && [ "$SCRIPT_DIR" = "$(cd "$USER_DIR/bin" && pwd)" ]; then
    echo "schemaf ${SCHEMAF_VER} — ${PROJECT_NAME} (run side)" >&2
    _schemaf_runside "$CMD" "$@"
    exit 0
  fi
  echo "ERROR: schemaf.toml not found in the same directory as this script."
  echo "       Place schemaf.sh next to your schemaf.toml — see schemaf documentation."
  echo "       (On a run host, use ~/.${PROJECT_NAME}/bin/schemaf.sh, installed by an artifact's load.)"
  exit 1
fi

PROJECT_ROOT="$SCRIPT_DIR"
cd "$PROJECT_ROOT"

# Banner to stderr, so command stdout stays clean for capture (e.g. auth token).
echo "schemaf ${SCHEMAF_VER} — ${PROJECT_NAME}" >&2

# Env files: build reads only SCHEMAF_RUNTIME (see _schemaf_env_runtime), run
# loads the production env after building, everything else the dev env.
case "$CMD" in
  build|run) ;;
  *) _schemaf_load_env "$USER_DIR/dev/etc/env" ;;
esac

case "$CMD" in
  codegen)
    exec go run github.com/flocko-motion/schemaf/cmd/schemaf codegen all
    ;;
  test)
    _schemaf_check_fresh
    go run github.com/flocko-motion/schemaf/cmd/schemaf prerun test "$PROJECT_NAME"

    # Start ephemeral test environment (no volumes — all data discarded after tests).
    _schemaf_container compose -f compose.test.gen.yml up -d --wait

    # Query the random host port the runtime assigned to postgres:5432.
    PG_PORT=$(_schemaf_container compose -f compose.test.gen.yml port postgres 5432 | awk -F: '{print $NF}')
    export DATABASE_URL="postgres://schemaf:dev@localhost:${PG_PORT}/${PROJECT_NAME}?sslmode=disable"

    # Set URL env vars for project sidecar services (generated by codegen).
    # shellcheck source=/dev/null
    source gen/test-env.sh

    # Run tests, capture exit code, then tear down regardless of result.
    TEST_EXIT=0
    go run github.com/flocko-motion/schemaf/cmd/schemaf test "$@" || TEST_EXIT=$?
    _schemaf_container compose -f compose.test.gen.yml down
    exit $TEST_EXIT
    ;;
  build)
    _schemaf_env_runtime "$USER_DIR/dev/etc/env"
    _schemaf_build "$@"
    ;;
  run)
    case "${1:-}" in
      --image|--image=*) _die "run --image starts a loaded artifact; on this host use ~/.${PROJECT_NAME}/bin/schemaf.sh run --image <tag> (plain ./schemaf.sh run builds this checkout)" ;;
    esac
    # run = build, then start that image (INSTALL.md › Deployment › Single-user hosts).
    _schemaf_env_runtime "$USER_DIR/etc/env"
    _schemaf_check_runtime compose
    _schemaf_check_volume
    _schemaf_build
    _schemaf_load_env "$USER_DIR/etc/env"
    export SCHEMAF_IMAGE="$BUILT_IMAGE"
    # Dev and production can't coexist: stop the dev stack first.
    if [ -f compose.dev.gen.yml ] \
      && [ -n "$(_schemaf_container compose -f compose.gen.yml -f compose.dev.gen.yml ps -q 2>/dev/null)" ]; then
      echo "Stopping dev services before production start..." >&2
      _schemaf_container compose -f compose.gen.yml -f compose.dev.gen.yml down
    fi
    _schemaf_container --exec compose -f compose.gen.yml up "$@"
    ;;
  dev)
    exec go run "${PROJECT_ROOT}/go" dev "$@"
    ;;
  upgrade)
    TARGET="${1:-}"
    if [ -z "$TARGET" ]; then
      # Query GitHub for the latest tag instead of Go proxy (which caches @latest for ~30min).
      # Capture the full tag list first, then pick the highest version with pure bash.
      # Piping `git ls-remote` into `head` makes git exit on SIGPIPE (141) once head
      # closes the pipe after the first line, which trips `set -o pipefail` + `set -e`.
      TAGS=$(git ls-remote --tags --sort=-v:refname https://github.com/flocko-motion/schemaf.git 'v*' 2>/dev/null || true)
      TARGET=${TAGS%%$'\n'*}   # first line = highest version
      TARGET=${TARGET##*/}     # strip the refs/tags/ prefix
      TARGET=${TARGET%%^*}     # strip any ^{} annotated-tag deref suffix
      if [ -z "$TARGET" ]; then
        echo "ERROR: could not determine latest version from GitHub" >&2
        exit 1
      fi
    fi
    # Accept a bare version ("1.9.0") as well as "v1.9.0" — Go needs the v prefix.
    case "$TARGET" in [0-9]*) TARGET="v$TARGET" ;; esac
    echo "Upgrading schemaf framework to ${TARGET}..."
    cd go
    OLD_VER=$(go list -m -f '{{"{{"}}.Version{{"}}"}}' github.com/flocko-motion/schemaf 2>/dev/null || echo "unknown")
    go get "github.com/flocko-motion/schemaf@${TARGET}"
    NEW_VER=$(go list -m -f '{{"{{"}}.Version{{"}}"}}' github.com/flocko-motion/schemaf)
    cd ..
    if [ "$OLD_VER" = "$NEW_VER" ]; then
      echo "Already at ${NEW_VER}"
    else
      echo "Upgraded: $OLD_VER → $NEW_VER"
    fi
    # Sync framework docs from the installed module into docs/schemaf/.
    SCHEMAF_DIR=$(cd go && go list -m -f '{{"{{"}}.Dir{{"}}"}}' github.com/flocko-motion/schemaf 2>/dev/null || true)
    if [ -n "$SCHEMAF_DIR" ] && [ -d "$SCHEMAF_DIR" ]; then
      mkdir -p docs/schemaf
      rm -f docs/schemaf/CLAUDE.md
      for f in README.md INSTALL.md EXTEND.md; do
        [ -f "$SCHEMAF_DIR/$f" ] && rm -f "docs/schemaf/$f" && cp "$SCHEMAF_DIR/$f" "docs/schemaf/$f" && chmod 644 "docs/schemaf/$f"
      done
      echo "Synced framework docs → docs/schemaf/"
    fi
    echo "Running codegen..."
    exec go run github.com/flocko-motion/schemaf/cmd/schemaf codegen all
    ;;
  *)
    SCHEMAF_CWD="$ORIG_PWD" exec go run "${PROJECT_ROOT}/go" "$CMD" "$@"
    ;;
esac
