# Regenerate with: ./schemaf.sh codegen
# Run via: ./schemaf.sh run   (or dev)
# The backend image is never built here: schemaf.sh builds it (./schemaf.sh build)
# and sets SCHEMAF_IMAGE when it starts the stack.
# SCHEMAF_INSTANCE_SUFFIX names a parallel dev instance (set by ./schemaf.sh dev
# --instance); unset, every name is the default stack's.

name: {{.Name}}${SCHEMAF_INSTANCE_SUFFIX:-}
{{if .Extensions}}
include:
{{- range .Extensions}}
  - {{.}}
{{- end}}
{{end}}
services:
  postgres:
    image: postgres:17-alpine
    container_name: {{.Name}}${SCHEMAF_INSTANCE_SUFFIX:-}-postgres
    environment:
      POSTGRES_USER: schemaf
      POSTGRES_PASSWORD: ${DB_PASS:-dev}
      POSTGRES_DB: {{.Name}}
    volumes:
      - postgres-data:/var/lib/postgresql/data
    networks:
      - net
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U schemaf -d {{.Name}}"]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 10s
    restart: unless-stopped

  backend:
    image: "${SCHEMAF_IMAGE:?set by schemaf.sh — use ./schemaf.sh run}"
    pull_policy: never
    container_name: {{.Name}}${SCHEMAF_INSTANCE_SUFFIX:-}-backend
    env_file:
      - path: ${HOME}/.{{.Name}}/etc/env
        required: false
    environment:
      SCHEMAF_ENV: docker
      SCHEMAF_DEV: "" # production; beats a SCHEMAF_DEV in env_file
      DB_PASS: ${DB_PASS:-dev}
      PORT: "{{.Port}}"
      SCHEMAF_IMAGE: ${SCHEMAF_IMAGE} # api.Updates: the running version
      BACKUP_SSH_HOST: ${BACKUP_SSH_HOST:-}
      BACKUP_SSH_PORT: ${BACKUP_SSH_PORT:-22}
      BACKUP_SSH_USER: ${BACKUP_SSH_USER:-}
      BACKUP_SSH_KEY: /run/secrets/backup_key
      BACKUP_PATH: ${BACKUP_PATH:-/backups}
      BACKUP_RETAIN: ${BACKUP_RETAIN:-30}
      BACKUP_HOUR: ${BACKUP_HOUR:-3}
    ports:
      - "{{.Port}}:{{.Port}}"
    # The run host's updates (EXTEND.md › Updates): read-only, and the request
    # file writable. schemaf.sh creates them before it starts the stack.
    volumes:
      - ${HOME}/.{{.Name}}/updates:/schemaf/updates:ro
      - ${HOME}/.{{.Name}}/updates/request:/schemaf/updates/request
    secrets:
      - backup_key
    networks:
      - net
    depends_on:
      postgres:
        condition: service_healthy
    restart: unless-stopped

secrets:
  backup_key:
    file: ${BACKUP_SSH_KEY_PATH:-/dev/null}

networks:
  net:
    driver: bridge
    name: {{.Name}}${SCHEMAF_INSTANCE_SUFFIX:-}-net

volumes:
  postgres-data:
    name: {{.Name}}${SCHEMAF_INSTANCE_SUFFIX:-}-postgres-data
